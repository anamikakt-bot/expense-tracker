generator client {
provider = "prisma-client-js"
}
datasource db{
provider = "postgresql"
url = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  categories Category[]
  expenses   Expense[]
  budgets    Budget[]
}

enum Role {
  USER
  ADMIN
}

model Category {
  id     String  @id @default(uuid())
  name   String
  color  String?
  user   User    @relation(fields: [userId], references: [id])
  userId String

  expenses Expense[]
  budgets  Budget[]
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String?
  date        DateTime @default(now())
  type        ExpenseType @default(EXPENSE)

  user       User     @relation(fields: [userId], references: [id])
  userId     String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
}

enum ExpenseType {
  EXPENSE
  INCOME
}

model Budget {
  id          String   @id @default(uuid())
  month       Int
  year        Int
  limitAmount Float

  user       User     @relation(fields: [userId], references: [id])
  userId     String
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
}
